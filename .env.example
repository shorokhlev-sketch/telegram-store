BOT_TOKEN=
BOT_USERNAME=
MINIAPP_SHORT_NAME=        # from BotFather /newapp
CHANNEL_ID=                # -100...
ADMIN_IDS=                 # telegram_id, comma-separated
SELLER_USERNAME=           # seller's @username without @, for the "message seller" button
LEADS_CHAT_ID=             # where the bot sends buyer leads; empty = first of ADMIN_IDS
PUBLIC_BASE_URL=https://example.com
WEBHOOK_SECRET=
DB_PATH=/data/app.db
MEDIA_DIR=/data/media
BACKUP_CHAT_ID=            # chat that receives the daily db.gz; empty/0 = backups disabled
BACKUP_HOUR_UTC=3          # hour (0-23, UTC) the daily backup runs at
SET_WEBHOOK_ON_START=1     # 0 for local dev without a public URL
# WEB_DIST_DIR=             # optional; built frontend to serve. Default: <repo>/web/dist
SHOP_NAME=                 # shop name in the bot's welcome to customers; empty = plain greeting

# Frontend build: Vite reads these from the shell or web/.env, not from this file
# VITE_SHOP_NAME=           # shop name in the site and Mini App header; empty = "Apple Resale"
# VITE_BASE=/               # sub-path the app is served under, e.g. /shop/
# VITE_API_PROXY=           # dev server only: backend to proxy /api to; default http://127.0.0.1:8000
